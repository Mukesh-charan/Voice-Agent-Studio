# Copy this file to ".env" and fill in your key.

# --- Groq (default: free tier, very fast, great for voice) ---
# Get a free key at https://console.groq.com  (no credit card needed)
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# --- Deployment ---
# When hosting over HTTPS (Render/Fly/etc.), set this to "true" so the login
# cookie is marked Secure. Leave "false" for local http://localhost.
SESSION_COOKIE_SECURE=false

# --- Alternative: local Ollama (free, runs on the 4050 GPU laptop) ---
# Install Ollama, run:  ollama pull qwen2.5:3b
# LLM_API_KEY=ollama          # any non-empty string; Ollama ignores it
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# --- Alternative: Google Gemini (free tier) ---
# Uses an OpenAI-compatible endpoint; get a key at https://aistudio.google.com
# LLM_API_KEY=your_gemini_key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
